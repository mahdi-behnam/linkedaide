#!/usr/bin/env bash
# LinkedAide Git pre-push hook
# Verifies linting, formatting, static types, and unit tests before pushing to remote.

set -e

echo "🚀 [pre-push] Verifying code quality before pushing to remote..."

echo "1/6 Checking Python linting with Ruff..."
uv run ruff check .

echo "2/6 Checking Python formatting with Ruff..."
uv run ruff format --check .

echo "3/6 Checking Python static types with Mypy..."
uv run mypy src tests scripts

echo "4/6 Running fast unit test verification with Pytest..."
uv run pytest tests/unit/test_cli.py tests/unit/test_config.py tests/unit/test_schemas.py

# Detect Node.js / npm environment (including common paths for GUI clients)
if ! command -v npm &> /dev/null; then
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    export NVM_DIR="$HOME/.nvm"
    # shellcheck disable=SC1090
    \. "$NVM_DIR/nvm.sh"
  elif [ -x "/opt/homebrew/bin/npm" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
  elif [ -x "/usr/local/bin/npm" ]; then
    export PATH="/usr/local/bin:$PATH"
  fi
fi

if command -v npm &> /dev/null; then
  echo "5/6 Checking Cloudflare Edge Relay static types..."
  if [ -d "infra/edge-relay/node_modules" ]; then
    (cd infra/edge-relay && npm run typecheck)
  elif git diff --name-only origin/main...HEAD 2>/dev/null | grep -q "^infra/edge-relay/" || git diff --name-only HEAD~1 2>/dev/null | grep -q "^infra/edge-relay/"; then
    echo "📦 Installing infra/edge-relay dependencies to verify TypeScript changes..."
    (cd infra/edge-relay && npm ci)
    (cd infra/edge-relay && npm run typecheck)
  else
    echo "ℹ️  [pre-push] infra/edge-relay/node_modules not found and no relay changes detected; skipping."
  fi

  echo "6/6 Checking Desktop App static types..."
  if [ -d "desktop/node_modules" ]; then
    (cd desktop && npm run typecheck)
  elif git diff --name-only origin/main...HEAD 2>/dev/null | grep -q "^desktop/" || git diff --name-only HEAD~1 2>/dev/null | grep -q "^desktop/"; then
    echo "📦 Installing desktop dependencies to verify TypeScript changes..."
    (cd desktop && npm ci)
    (cd desktop && npm run typecheck)
  else
    echo "ℹ️  [pre-push] desktop/node_modules not found and no desktop changes detected; skipping."
  fi
else
  echo "ℹ️  [pre-push] Node/npm not available in environment; skipping TypeScript checks."
fi

echo "✅ [pre-push] All pre-push checks passed successfully. Proceeding with push."
