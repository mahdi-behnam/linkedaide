{
  "name": "edge-relay",
  "version": "1.0.0",
  "description": "Cloudflare Worker edge relay translating Telegram inline button callbacks to GitHub repository_dispatch events, Desktop API, and Realtime Hub",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && uv run python ../../scripts/register_telegram_webhook.py --set-commands",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "wrangler": "^3.50.0"
  }
}
