{
  "name": "linkedaide-desktop",
  "version": "1.4.3",
  "description": "Desktop Control Panel for LinkedAide",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": {
    "name": "Mahdi Behnam",
    "email": "mahdi.behnam20@gmail.com"
  },
  "desktopName": "LinkedAide.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"fs.mkdirSync('build', {recursive: true}); if (fs.existsSync('public/icon.ico')) fs.copyFileSync('public/icon.ico', 'build/icon.ico'); if (fs.existsSync('public/icon.png')) fs.copyFileSync('public/icon.png', 'build/icon.png'); fs.cpSync('electron/tray/assets', 'dist-electron/tray/assets', {recursive: true, force: true}); fs.writeFileSync('dist-electron/package.json', JSON.stringify({type: 'commonjs'}))\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "package": "npm run build && npm run build:electron",
    "postinstall": "node scripts/ensure-electron.cjs",
    "prestart": "node scripts/ensure-electron.cjs",
    "start": "electron .",
    "dist": "npm run package && electron-builder",
    "dist:win": "npm run package && electron-builder --win",
    "dist:mac": "npm run package && electron-builder --mac",
    "dist:linux": "npm run package && electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdi-behnam/linkedaide.git"
  },
  "build": {
    "appId": "com.linkedaide.desktop",
    "productName": "LinkedAide",
    "publish": {
      "provider": "github",
      "owner": "mahdi-behnam",
      "repo": "linkedaide",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "LinkedAide.${ext}",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LinkedAide",
      "artifactName": "LinkedAide-Setup.${ext}"
    },
    "portable": {
      "artifactName": "LinkedAide-Portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Mahdi Behnam <mahdi.behnam20@gmail.com>",
      "syncDesktopName": true,
      "artifactName": "LinkedAide.${ext}"
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
