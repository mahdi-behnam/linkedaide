# ==============================================================================
# LinkedIn Human-in-the-Loop AI Agent - Environment Configuration Example
# Copy this file to .env and fill in your confidential values.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# NVIDIA NIM LLM Configuration
# ------------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key
NIM_MODEL_PRIMARY=meta/llama-3.3-70b-instruct
NIM_MODEL_FALLBACK=meta/llama-3.1-8b-instruct
NIM_TEMPERATURE=0.2
NIM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_AUTHORIZED_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# LinkedIn Session & Encryption
# ------------------------------------------------------------------------------
# 32-byte url-safe base64-encoded key generated via cryptography.fernet.Fernet.generate_key()
SESSION_ENCRYPTION_KEY=your-fernet-encryption-key-base64=
# Optional: Base64-encoded encrypted storage state for CI/CD environments
LINKEDIN_SESSION_STATE_ENC=

# ------------------------------------------------------------------------------
# Agent Persona & Focus Areas
# ------------------------------------------------------------------------------
USER_FOCUS_AREAS="AI Agents, Python, Distributed Systems, Software Architecture, LLM Engineering"
USER_PERSONA="Principal AI Systems Engineer sharing technical insights, architecture patterns, and practical experience"

# ------------------------------------------------------------------------------
# Safety & Rate Limits
# ------------------------------------------------------------------------------
MAX_COMMENTS_PER_DAY=5
MAX_POSTS_PER_DAY=1
MAX_SUGGESTIONS_PER_RUN=3
PENDING_ACTION_TTL_HOURS=12
AGENT_PAUSED=false
DRY_RUN=false

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
