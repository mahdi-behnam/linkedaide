# ==============================================================================
# LinkedIn Human-in-the-Loop AI Agent - Environment Configuration Example
# Copy this file to .env (e.g. `cp .env.example .env`) and fill in your values.
# IMPORTANT: NEVER commit your actual .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Choose your LLM provider:
# Options: nvidia (default), openai, anthropic, gemini, groq, ollama, openai-compatible
LLM_PROVIDER=nvidia

# --- Provider API Keys & Endpoints ---
# NVIDIA NIM (Required when LLM_PROVIDER=nvidia) - https://build.nvidia.com/
NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key

# OpenAI (Required when LLM_PROVIDER=openai) - https://platform.openai.com/
# OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (Required when LLM_PROVIDER=anthropic) - https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google Gemini (Required when LLM_PROVIDER=gemini) - https://aistudio.google.com/
# GEMINI_API_KEY=your-gemini-api-key
# (GOOGLE_API_KEY is also accepted as an alias)

# Groq (Required when LLM_PROVIDER=groq) - https://console.groq.com/
# GROQ_API_KEY=gsk-your-groq-api-key

# Ollama (When LLM_PROVIDER=ollama) - Local Ollama server
# OLLAMA_BASE_URL=http://localhost:11434

# --- Model Selection ---
# Model settings accept LLM_MODEL_* or NIM_MODEL_* aliases.
# Defaults depend on provider:
# - nvidia: nvidia/nemotron-3-super-120b-a12b / openai/gpt-oss-20b
# - openai: gpt-4o / gpt-4o-mini
# - anthropic: claude-3-5-sonnet-latest / claude-3-5-haiku-latest
# - gemini: gemini-2.0-flash / gemini-1.5-flash
# - groq: llama-3.3-70b-versatile / llama-3.1-8b-instant
# - ollama: llama3.2 / llama3.2
# - openai-compatible: custom model names
LLM_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_FALLBACK=openai/gpt-oss-20b

# Optional lightweight LLM dedicated exclusively to fast post triage (leave blank to use primary or provider default)
# LLM_MODEL_TRIAGE=openai/gpt-oss-20b

# Generation parameters
NIM_TEMPERATURE=0.2
NIM_TIMEOUT_SECONDS=60.0
NIM_MAX_TOKENS=1024
# NIM_TOP_P=0.9
# NIM_MAX_CONCURRENCY=4
# Custom base URL (e.g. for self-hosted NIM or openai-compatible endpoints like Together, vLLM, OpenRouter)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# 2. Telegram Bot Configuration (For Human-in-the-Loop Reviews)
# ------------------------------------------------------------------------------
# Bot token created via Telegram's @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your numeric Telegram User/Chat ID (find it via @userinfobot or @myidbot)
# Only this Telegram account is authorized to review/approve actions.
TELEGRAM_AUTHORIZED_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 3. LinkedIn Session & Encryption Keys
# ------------------------------------------------------------------------------
# 32-byte url-safe base64 Fernet encryption key used to encrypt browser storage state.
# Auto-generate with: uv run python scripts/generate_secrets.py --type session
SESSION_ENCRYPTION_KEY=your-fernet-encryption-key-base64=

# Base64-encoded encrypted Playwright session state (for GitHub Actions CI/CD).
# Auto-generated by running: uv run python scripts/extract_linkedin_session.py
LINKEDIN_SESSION_STATE_ENC=

# Path to decrypted local storage state for local runs (default: storage_state.json)
# LINKEDIN_STORAGE_STATE_PATH=storage_state.json

# ------------------------------------------------------------------------------
# 4. Agent Persona & Domain Focus Areas
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of topics of interest used during feed triage
USER_FOCUS_AREAS="AI Agents, Python, Distributed Systems, Software Architecture, LLM Engineering"

# Tone and background guidelines injected into comment/post generation prompts
USER_PERSONA="Principal AI Systems Engineer sharing technical insights, architecture patterns, and practical experience. Tone is concise, collegial, and evidence-driven. Avoid generic praise and buzzwords."

# Maximum words per drafted comment (range: 10 - 200, default: 80)
MAX_COMMENT_WORDS=80

# ------------------------------------------------------------------------------
# 5. Safety, Operational Controls & Rate Limits
# ------------------------------------------------------------------------------
# Hard daily cap on approved comments posted to LinkedIn
MAX_COMMENTS_PER_DAY=5

# Hard daily cap on original LinkedIn posts
MAX_POSTS_PER_DAY=1

# Maximum suggestions delivered to Telegram per scout run
MAX_SUGGESTIONS_PER_RUN=3

# Time-to-live (hours) before an unapproved Telegram suggestion expires
PENDING_ACTION_TTL_HOURS=12

# Emergency kill switch (set to true to immediately pause all agent workflows)
AGENT_PAUSED=false

# Dry-run mode (when true, executes scraping & drafting, but prevents real LinkedIn writes)
DRY_RUN=false

# ------------------------------------------------------------------------------
# 6. Logging & State Storage
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory where durable version-controlled state is stored (default: state)
# STATE_DIR=state

# ------------------------------------------------------------------------------
# 7. Cloudflare Relay Worker Secrets (Reference for infra/telegram-relay-worker)
# ------------------------------------------------------------------------------
# Note: The Cloudflare Worker uses its own secrets set via `npx wrangler secret put <NAME>`.
# They are listed here for your convenience and local reference:
#
# Secret used by Telegram to authenticate webhook calls to Cloudflare Worker (X-Telegram-Bot-Api-Secret-Token).
# Auto-generate with: uv run python scripts/generate_secrets.py --type webhook
# TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-token
#
# GitHub PAT with repo/contents permissions to trigger repository_dispatch events:
# GITHUB_DISPATCH_PAT=ghp_your_github_personal_access_token
#
# GitHub Repository Owner and Name:
# GITHUB_REPO_OWNER=your-github-username
# GITHUB_REPO_NAME=linkedin-hitl-agent
